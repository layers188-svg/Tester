# House Dark environment variables (brief §9). Copy to .env.local for
# local development. Never commit real values — this file must never
# contain secrets, only names and placeholder shapes.

# Public base URL of this deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (brief §23 item 1 — Logan creates the project).
# Project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (brief §23 item 2 — Logan creates the account and verifies the
# sending domain). Also configure this same API key as Supabase's
# custom SMTP provider so auth emails do not rely on Supabase's shared
# demo SMTP — see OPERATIONS.md.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="House Dark <hello@yourdomain.com>"

# Comma separated, lowercase emails that are promoted to the owner role
# the first time they sign in. See src/app/api/auth/ensure-profile.
ADMIN_EMAILS=owner@example.com

# Shared secret the scheduled worker must present to POST /api/cron.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-value

# Testing only — leave unset in any real deployment.
# When set, /join?k=<this value> signs in from an email address alone,
# with no code. Used while Supabase is still on its built-in email
# provider, which rate-limits to a couple of messages an hour and whose
# Magic Link template cannot be given {{ .Token }} on the free tier.
# NOT NEXT_PUBLIC_: the key never enters the client bundle, so a visitor
# without the link sees an ordinary join page. Min 16 characters.
# TEST_SIGNIN_KEY=

# The wide film catalogue behind the house's own 62 films.
#
# Unset: Wikidata. Open, anonymous, free and unlimited, so the library
# is limitless without an account or a bill. NOTE: src/lib/films/
# wikidata.ts has not yet been run against the live endpoint — see the
# note at the top of that file.
#
# TMDB_API_KEY=...   better data, wants a (free) account
#
# Set to "off" to run Search on the 62 hand-written films alone. The
# e2e suite does this so its journeys never depend on a third party.
# HOUSE_DARK_WIDE_CATALOGUE=off

# The editorial engine that writes the house's six words for a film it
# has not described before. Without it, Search serves only films that
# already have a record.
# ANTHROPIC_API_KEY=
